# ============================================================
# EnglishQuest - Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no repositório (já está no .gitignore).
# ============================================================

# ---- Banco de Dados (OBRIGATÓRIO) ----
# PostgreSQL connection string
# Exemplo: postgresql://user:password@localhost:5432/englishquest?schema=public
DATABASE_URL=""

# ---- Auth.js / NextAuth (OBRIGATÓRIO) ----
# Gere um secret seguro: openssl rand -base64 32
AUTH_SECRET=""
# URL base do app (use http://localhost:3000 para dev local)
AUTH_URL="http://localhost:3000"

# ---- GitHub OAuth (OPCIONAL) ----
# Crie um OAuth App em: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- Google OAuth (OPCIONAL) ----
# Crie um OAuth Client em: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Sentry - Error Tracking (OPCIONAL) ----
# Crie um projeto em: https://sentry.io
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ---- PostHog - Analytics (OPCIONAL) ----
# Crie um projeto em: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---- Professor / IA (OPCIONAL) ----
# Secret usada para criptografar as chaves de API dos usuários (AES-256-GCM).
# Gere com: openssl rand -base64 32  (mín. 16 caracteres)
LLM_ENCRYPTION_SECRET=""

# Chaves de API para fallback em dev (se o usuário não configurar no jogo)
NVIDIA_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
